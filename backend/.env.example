SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Obligatoire en production (≥ 16 caractères). Générer : openssl rand -base64 32
JWT_SECRET=change-me-in-production-please

# Microsoft Entra ID — SPA + API (scope access_as_user). Pas de Client Secret.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_API_CLIENT_ID=

# Lecture Microsoft Graph (PayFlow-Provisioning). Jamais dans VITE_*.
# Permission app minimale : User.Read.All (liste /users + appRoleAssignments).
# Application.Read.All (ou Directory.Read.All) est optionnelle : elle permet de lire les noms de rôles.
AZURE_GRAPH_CLIENT_ID=
AZURE_GRAPH_CLIENT_SECRET=
# Optionnel si Application.Read.All est absent — identifiants des rôles applicatifs PayFlow.
AZURE_PAYFLOW_ROLE_ADMIN_ID=
AZURE_PAYFLOW_ROLE_HR_ID=
AZURE_PAYFLOW_ROLE_EMPLOYEE_ID=
