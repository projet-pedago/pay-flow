SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Obligatoire en production (≥ 16 caractères). Générer : openssl rand -base64 32
JWT_SECRET=change-me-in-production-please

# Microsoft Entra ID — SPA + API (scope access_as_user). Pas de Client Secret.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_API_CLIENT_ID=

# PayFlow-Provisioning (backend uniquement, Microsoft Graph). Jamais dans VITE_*.
AZURE_PROVISIONING_CLIENT_ID=
AZURE_PROVISIONING_CLIENT_SECRET=
